# Laufzeitmodus: development, production oder test.
# Docker Compose setzt production für den App-Service und test für den Test-Service.
EBAUTEILEFUCHS_APP_ENV=development

# Standardmäßig im lokalen Netzwerk erreichbar
EBAUTEILEFUCHS_HOST=0.0.0.0
EBAUTEILEFUCHS_PORT=8008

# Bei Docker steuert dieser Port zugleich die veröffentlichte Portfreigabe.
# Für Smartphone-QR-Codes die dauerhaft erreichbare LAN-Adresse unten eintragen.

# Leer lassen, um den plattformspezifischen Standard zu verwenden.
# In der Entwicklung ist das ./data relativ zum Repository.
# EBAUTEILEFUCHS_DATA_DIR=C:/Users/Name/AppData/Local/eBauteileFuchs

# Optionales Ziel für ZIP-Sicherungen. Standard: Unterordner backups im Datenordner.
# EBAUTEILEFUCHS_BACKUP_DIR=D:/eBauteileFuchs-Sicherungen

# Maximale Größe einer hochgeladenen Sicherung in MB (1 bis 4096).
EBAUTEILEFUCHS_RESTORE_UPLOAD_LIMIT_MB=512

# Optional vollständige SQLAlchemy-URL statt der SQLite-Standarddatenbank.
# EBAUTEILEFUCHS_DATABASE_URL=sqlite+pysqlite:///C:/path/to/ebauteilefuchs.db

# Optional für vollständige URLs in Lagerplatz- und Smartphone-QR-Codes,
# beispielsweise: http://192.168.1.42:8008
# EBAUTEILEFUCHS_PUBLIC_BASE_URL=http://192.168.1.42:8008

# Optionales HTTPS für PWA-Installation und Kamera-Barcode-Scan. Zertifikat und
# Schlüssel immer gemeinsam konfigurieren; private Schlüssel nicht committen.
# EBAUTEILEFUCHS_SSL_CERTFILE=C:/Pfad/zum/lokalen-zertifikat.pem
# EBAUTEILEFUCHS_SSL_KEYFILE=C:/Pfad/zum/lokalen-schluessel.pem

EBAUTEILEFUCHS_LOG_LEVEL=INFO

# Ausschließlich lokal eintragen. Eine echte .env niemals committen.
EBAUTEILEFUCHS_MOUSER_API_KEY=
EBAUTEILEFUCHS_MOUSER_TIMEOUT_SECONDS=8
