[Unit]
Description=eBauteileFuchs local inventory service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ebauteilefuchs
Group=ebauteilefuchs
WorkingDirectory=/opt/ebauteilefuchs
EnvironmentFile=-/etc/ebauteilefuchs/ebauteilefuchs.env
Environment=EBAUTEILEFUCHS_APP_ENV=production
Environment=EBAUTEILEFUCHS_DATA_DIR=/var/lib/ebauteilefuchs
ExecStartPre=/opt/ebauteilefuchs/.venv/bin/python -m alembic upgrade head
ExecStart=/opt/ebauteilefuchs/.venv/bin/python -m ebauteilefuchs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/ebauteilefuchs

[Install]
WantedBy=multi-user.target
